node_modules/
public/vendor/
dist/
coverage/
.nyc_output/
# Locally generated benchmark/review exports may contain private paths.
reports/
.local/

# Local sync/client state
.obsidian/
.trash/
.sync/
.livesync/

# Build and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Local deployment overrides
compose.override.yaml
docker-compose.override.yml
deploy/local/
