{
  "name": "vaultmind",
  "version": "0.1.0",
  "description": "Self-hosted, provider-neutral RAG workspace for Obsidian vaults",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage",
    "index": "node scripts/reindex.mjs",
    "eval": "node scripts/evaluate-retrieval.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "verify": "npm run check && npm test && npm run security:scan",
    "postinstall": "node scripts/sync-vendor-assets.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "katex": "0.18.4",
    "marked": "18.0.11"
  }
}
