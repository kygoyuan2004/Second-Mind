{
  "name": "second-mind",
  "version": "0.2.0",
  "description": "Self-hosted Obsidian knowledge workspace powered by the Claude Agent SDK",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "start": "node src/bootstrap.mjs",
    "dev": "node --watch src/bootstrap.mjs",
    "check": "node scripts/check.mjs",
    "site:build": "node scripts/site-build.mjs",
    "site:check": "node scripts/site-check.mjs",
    "docs:screenshots": "node scripts/capture-screenshots.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --experimental-test-coverage",
    "index": "node scripts/reindex.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:ocr": "node scripts/scan-screenshot-ocr.mjs",
    "security:history": "node scripts/scan-history.mjs",
    "verify": "npm run check && npm test && npm run security:scan",
    "postinstall": "node scripts/sync-vendor-assets.mjs",
    "start:server": "node src/bootstrap.mjs",
    "test:desktop": "node --import ./test/test-environment.mjs --test test/desktop-backend.test.mjs test/desktop-shell.test.mjs test/platform/*.test.mjs",
    "runtime:prepare": "python3 scripts/prepare-windows-runtime.py",
    "dist:win": "node scripts/build-windows.mjs",
    "desktop:build:win": "node scripts/build-windows.mjs",
    "test:electron": "node --test test/desktop-shell.electron.mjs",
    "test:runtime": "node scripts/run-tests.mjs --runtime-only",
    "desktop:dev": "electron .",
    "desktop:build:linux": "bash scripts/build-linux.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.247",
    "@modelcontextprotocol/sdk": "1.32.2",
    "dompurify": "3.4.18",
    "katex": "0.18.10",
    "marked": "18.0.7",
    "tavily-mcp": "0.2.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "adm-zip": "0.6.1",
    "electron": "44.11.5",
    "electron-builder": "26.15.3",
    "extract-zip": "2.0.1",
    "html-validate": "11.13.0"
  },
  "main": "desktop/main.mjs",
  "productName": "Second Mind",
  "homepage": "https://github.com/kygoyuan2004/Second-Mind",
  "overrides": {
    "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
  }
}
