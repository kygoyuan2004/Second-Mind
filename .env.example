# Use the administrator page for provider configuration. Never commit a real key.
APP_NAME=Second Mind
VAULT_LABEL=My Obsidian Vault
HOST=127.0.0.1
PORT=8787
TIMEZONE=UTC
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
SECURE_COOKIE=false
TRUST_PROXY=false

# State is private and outside the Vault. SDK state is created under sdk-v1.
VAULT_PATH=./vault
DATA_DIR=./data
INDEX_DIR=./data/index
DRAFT_DIR=./data/drafts
RECOVERY_DIR=./data/recovery
CONVERSATION_FILE=./data/conversations.json
AUDIT_FILE=./data/audit.jsonl
VAULT_EXCLUDED_PATHS=.obsidian,.trash,.git,.sync,.livesync,node_modules

# Legacy draft destinations only. New SDK notes retain original daily_doc paths:
# daily_doc/日记, daily_doc/计划, daily_doc/随心草稿 (including video notes).
DIARY_DIR=Second-Mind/Diary
PLAN_DIR=Second-Mind/Plans
SCRATCH_DIR=Second-Mind/Inbox
DIARY_TEMPLATE=
PLAN_TEMPLATE=
VAULT_AUTO_CREATE_PATHS=false

# Optional initial direct-Node model binding. Prefer managed settings and *_FILE.
LLM_PROVIDER=anthropic
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

WEB_SEARCH_ENABLED=false
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_MS=60000
WEB_SEARCH_RESULT_COUNT=8

EMBEDDING_PROVIDER=disabled
EMBEDDING_API_BASE=
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=20
EMBEDDING_TIMEOUT_MS=12000
ALLOW_INSECURE_PROVIDER_HTTP=false
INDEX_WATCH=true
INDEX_RECONCILE_SECONDS=300

# Optional local Whisper model directory. Docker includes the Python/ffmpeg tools.
KNOWLEDGE_SPEECH_MODEL=small

MAX_JSON_BODY_BYTES=25165824
MAX_ATTACHMENT_COUNT=8
MAX_ATTACHMENT_BYTES=5242880
MAX_ATTACHMENT_TOTAL_BYTES=15728640
RECOVERY_RETENTION_DAYS=30
SYNC_PROVIDER=filesystem
SYNC_DISPLAY_NAME=Filesystem
