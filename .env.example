# Application
APP_NAME=Second Mind
VAULT_LABEL=My Obsidian Vault
HOST=127.0.0.1
PORT=8787
TIMEZONE=UTC

# Authentication (use *_FILE instead when deploying with Docker secrets)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
SECURE_COOKIE=false
TRUST_PROXY=false

# Local paths. compose.yaml overrides VAULT_PATH and DATA_DIR inside the container.
VAULT_PATH=./vault
DATA_DIR=./data
INDEX_DIR=./data/index
DRAFT_DIR=./data/drafts
RECOVERY_DIR=./data/recovery
CONVERSATION_FILE=./data/conversations.json
AUDIT_FILE=./data/audit.jsonl
VAULT_AUTO_CREATE_PATHS=true
VAULT_EXCLUDED_PATHS=.obsidian,.trash,.git,.sync,.livesync,node_modules

# The only Vault directories that Second Mind may write.
DIARY_DIR=Second-Mind/Diary
PLAN_DIR=Second-Mind/Plans
SCRATCH_DIR=Second-Mind/Inbox
# Optional template paths relative to the Vault. Leave blank for built-in templates.
DIARY_TEMPLATE=
PLAN_TEMPLATE=

# Chat model: openai-compatible works with OpenAI, DashScope compatible mode,
# DeepSeek, Ollama, vLLM, LM Studio, and similar APIs.
LLM_PROVIDER=openai-compatible
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TEMPERATURE=0.2

# Set true only for an HTTP endpoint on a trusted private network (for example,
# a model container on the same Docker network). Loopback HTTP needs no opt-in.
ALLOW_INSECURE_PROVIDER_HTTP=false

# Retrieval: disabled = BM25 only. Enable one provider for hybrid BM25 + vector RAG.
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_BASE=http://127.0.0.1:11434/v1
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=30000
RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=30000
# Deep Q&A performs bounded query decomposition, multiple hybrid searches,
# evidence fusion, and a final cited answer. Note-writing modes remain Normal.
DEEP_TASKS_ENABLED=true
RAG_DEEP_TOP_K=16
INDEX_WATCH=true
INDEX_RECONCILE_SECONDS=300

# The application always consumes a local filesystem Vault. This label records
# which external process materializes it; it does not put credentials in the app.
SYNC_PROVIDER=filesystem
SYNC_DISPLAY_NAME=Filesystem

# Upload/request limits in bytes
MAX_JSON_BODY_BYTES=25165824
MAX_ATTACHMENT_COUNT=8
MAX_ATTACHMENT_BYTES=5242880
MAX_ATTACHMENT_TOTAL_BYTES=15728640
RECOVERY_RETENTION_DAYS=30

# Compose-only host settings
# These VAULTMIND_* names are legacy Compose compatibility identifiers. Keep
# them for existing deployments; they do not control the visible product name.
VAULT_HOST_PATH=./vault
VAULTMIND_BIND_IP=127.0.0.1
VAULTMIND_PORT=8787
VAULTMIND_UID=1000
VAULTMIND_GID=1000
