# Copy to a root-owned 0600 file outside the repository, replace placeholders,
# and reference it from vaultmind.service. Never place secret values here.
APP_NAME=Second Mind
VAULT_LABEL=@VAULT_LABEL@
HOST=127.0.0.1
PORT=@PORT@
TIMEZONE=@IANA_TIMEZONE@
TRUST_PROXY=true
SECURE_COOKIE=true

VAULT_PATH=@VAULT_PATH@
DATA_DIR=/var/lib/@STATE_DIRECTORY_NAME@
PUBLIC_DIR=@APP_DIR@/public
INDEX_DIR=/var/lib/@STATE_DIRECTORY_NAME@/index
DRAFT_DIR=/var/lib/@STATE_DIRECTORY_NAME@/drafts
RECOVERY_DIR=/var/lib/@STATE_DIRECTORY_NAME@/recovery
CONVERSATION_FILE=/var/lib/@STATE_DIRECTORY_NAME@/conversations.json
AUDIT_FILE=/var/lib/@STATE_DIRECTORY_NAME@/audit.jsonl
RECOVERY_RETENTION_DAYS=30
VAULT_AUTO_CREATE_PATHS=false
DIARY_DIR=@DIARY_DIR@
PLAN_DIR=@PLAN_DIR@
SCRATCH_DIR=@SCRATCH_DIR@
DIARY_TEMPLATE=
PLAN_TEMPLATE=
VAULT_EXCLUDED_PATHS=.obsidian,.trash,.git,.sync,.livesync,node_modules

ADMIN_USERNAME=@ADMIN_USERNAME@
ADMIN_PASSWORD_FILE=@SECRET_DIR@/admin_password
SESSION_SECRET_FILE=@SECRET_DIR@/session_secret
SESSION_TTL_SECONDS=43200

LLM_PROVIDER=@LLM_PROVIDER@
LLM_API_BASE=@LLM_API_BASE@
LLM_API_KEY_FILE=@SECRET_DIR@/llm_api_key
LLM_MODEL=@LLM_MODEL@
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TEMPERATURE=0.2

EMBEDDING_PROVIDER=disabled
EMBEDDING_API_BASE=@EMBEDDING_API_BASE@
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY_FILE=@SECRET_DIR@/embedding_api_key
EMBEDDING_MODEL=@EMBEDDING_MODEL@
EMBEDDING_DIMENSIONS=@EMBEDDING_DIMENSIONS@
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=30000
ALLOW_INSECURE_PROVIDER_HTTP=false

RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=30000
INDEX_WATCH=true
INDEX_RECONCILE_SECONDS=300

MAX_JSON_BODY_BYTES=25165824
MAX_ATTACHMENT_COUNT=8
MAX_ATTACHMENT_BYTES=5242880
MAX_ATTACHMENT_TOTAL_BYTES=15728640

SYNC_PROVIDER=@SYNC_PROVIDER@
SYNC_DISPLAY_NAME=@SYNC_DISPLAY_NAME@
