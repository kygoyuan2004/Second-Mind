{
  "name": "second-mind",
  "version": "0.1.0",
  "description": "Self-hosted Obsidian knowledge workspace powered by the Claude Agent SDK",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "start": "node src/bootstrap.mjs",
    "dev": "node --watch src/bootstrap.mjs",
    "check": "node scripts/check.mjs",
    "site:build": "node scripts/site-build.mjs",
    "site:check": "node scripts/site-check.mjs",
    "docs:screenshots": "node scripts/capture-screenshots.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --experimental-test-coverage",
    "index": "node scripts/reindex.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:ocr": "node scripts/scan-screenshot-ocr.mjs",
    "security:history": "node scripts/scan-history.mjs",
    "verify": "npm run check && npm test && npm run security:scan",
    "postinstall": "node scripts/sync-vendor-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.247",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dompurify": "3.4.15",
    "katex": "0.18.7",
    "marked": "18.0.7",
    "tavily-mcp": "0.2.22",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "html-validate": "11.13.0"
  }
}
