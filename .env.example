# Application
APP_NAME=Second Mind
VAULT_LABEL=My Obsidian Vault
HOST=127.0.0.1
PORT=8787
TIMEZONE=UTC

# Authentication (use *_FILE instead when deploying with Docker secrets)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
SECURE_COOKIE=false
TRUST_PROXY=false

# Local paths. compose.yaml overrides VAULT_PATH and DATA_DIR inside the container.
VAULT_PATH=./vault
DATA_DIR=./data
INDEX_DIR=./data/index
DRAFT_DIR=./data/drafts
RECOVERY_DIR=./data/recovery
CONVERSATION_FILE=./data/conversations.json
AUDIT_FILE=./data/audit.jsonl
VAULT_AUTO_CREATE_PATHS=true
VAULT_EXCLUDED_PATHS=.obsidian,.trash,.git,.sync,.livesync,node_modules

# The only Vault directories that Second Mind may write.
DIARY_DIR=Second-Mind/Diary
PLAN_DIR=Second-Mind/Plans
SCRATCH_DIR=Second-Mind/Inbox
# Optional template paths relative to the Vault. Leave blank for built-in templates.
DIARY_TEMPLATE=
PLAN_TEMPLATE=

# Chat models are configured from the authenticated administrator page. These
# environment fields are retained for legacy direct-Node deployments only.
LLM_PROVIDER=openai-compatible
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TEMPERATURE=0.2

# Optional Alibaba Cloud Model Studio WebSearch MCP. The fixed server endpoint
# is used only when the per-conversation “Web supplement” switch is enabled.
# This credential is independent from every LLM and Embedding credential.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_MS=60000
WEB_SEARCH_RESULT_COUNT=15
WEB_SEARCH_DEEP_RESULT_COUNT=6
WEB_SEARCH_MAX_RESULTS_PER_DOMAIN=2
WEB_SEARCH_MODEL_SOURCE_LIMIT=10
WEB_SEARCH_MAX_CONTEXT_CHARS=30000
# Optional trusted organization domains only (hostnames, no schemes or wildcards).
WEB_SEARCH_OFFICIAL_DOMAINS=

# Conversation-aware grounded research. Both switches are intentionally off in
# the generic project. The research loop requires the contextualizer and Deep.
QA_CONTEXTUALIZER_ENABLED=false
QA_CONTEXTUALIZER_TIMEOUT_MS=45000
QA_RESEARCH_LOOP_ENABLED=false
QA_EVIDENCE_TIMEOUT_MS=60000

# Optional safe server-side reading of HTTPS URLs returned by WebSearch. These
# values are hard-capped by the application; lowering them is supported.
WEB_READER_ENABLED=false
PDF_ENABLED=false
WEB_READER_PAGE_TIMEOUT_MS=15000
WEB_READER_BATCH_TIMEOUT_MS=40000
WEB_READER_HTML_MAX_BYTES=2097152
WEB_READER_PDF_MAX_BYTES=8388608
WEB_READER_PAGE_MAX_CHARS=16000
WEB_READER_TOTAL_MAX_CHARS=40000
WEB_READER_CONCURRENCY=2
WEB_READER_MAX_PAGES_PER_BATCH=3
WEB_READER_NORMAL_MAX_PAGES=2
WEB_READER_DEEP_MAX_PAGES_PER_ROUND=3
WEB_READER_MAX_REDIRECTS=3

# Optional paid fallback when a selected page cannot be read safely and the
# evidence is still insufficient. API_BASE is the workspace/region-specific
# Alibaba Model Studio compatible-mode base ending in /compatible-mode/v1.
# A Model Studio workspace key verified for Responses. Managed deployments can
# explicitly reuse the selected WebSearch key; a separately scoped key is
# recommended for cost and rotation isolation.
BAILIAN_RESPONSES_FALLBACK_ENABLED=false
BAILIAN_RESPONSES_FALLBACK_API_BASE=
BAILIAN_RESPONSES_FALLBACK_API_KEY=
BAILIAN_RESPONSES_FALLBACK_MODEL=qwen3.8-max
BAILIAN_RESPONSES_FALLBACK_TIMEOUT_MS=120000
BAILIAN_RESPONSES_FALLBACK_MAX_RESPONSE_BYTES=2097152
# Legacy exact /responses endpoint override; prefer API_BASE for new setups.
BAILIAN_RESPONSES_FALLBACK_ENDPOINT=

# Set true only for an HTTP endpoint on a trusted private network (for example,
# a model container on the same Docker network). Loopback HTTP needs no opt-in.
ALLOW_INSECURE_PROVIDER_HTTP=false

# Retrieval: disabled = BM25 only. Enable one provider for hybrid BM25 + vector RAG.
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_BASE=
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=30000
RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=30000
# Deep Q&A performs bounded query decomposition, multiple hybrid searches,
# evidence fusion, and a final cited answer. Note-writing modes remain Normal.
DEEP_TASKS_ENABLED=true
RAG_DEEP_TOP_K=16
INDEX_WATCH=true
INDEX_RECONCILE_SECONDS=300

# The application always consumes a local filesystem Vault. This label records
# which external process materializes it; it does not put credentials in the app.
SYNC_PROVIDER=filesystem
SYNC_DISPLAY_NAME=Filesystem

# Upload/request limits in bytes
MAX_JSON_BODY_BYTES=25165824
MAX_ATTACHMENT_COUNT=8
MAX_ATTACHMENT_BYTES=5242880
MAX_ATTACHMENT_TOTAL_BYTES=15728640
RECOVERY_RETENTION_DAYS=30

# Compose-only host settings. A parent directory can contain multiple immediate
# Obsidian Vault directories; each is discovered as a separate knowledge base.
SECOND_MIND_IMAGE=ghcr.io/kygoyuan2004/second-mind:latest
KNOWLEDGE_BASE_HOST_PATH=./vault
# These VAULTMIND_* names are legacy Compose compatibility identifiers. Keep
# them for existing deployments; they do not control the visible product name.
VAULT_HOST_PATH=./vault
VAULTMIND_BIND_IP=127.0.0.1
VAULTMIND_PORT=8787
VAULTMIND_UID=1000
VAULTMIND_GID=1000
